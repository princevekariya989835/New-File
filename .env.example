# Neon PostgreSQL Database URL
DATABASE_URL=

# Authentication Secret
AUTH_SECRET=

# Razorpay Online Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Site URL for canonical URLs & password recovery links (never rely on Host header)
SITE_URL=https://riotous.store

# Brevo Transactional Email (Exclusive Provider)
# Official API: POST https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=order@riotous.store
BREVO_SENDER_NAME=RIOTOUS
EMAIL_FROM=RIOTOUS <order@riotous.store>
EMAIL_MODE=production

# Private Administrator Notification Email (Stored in Cloudflare Worker secrets or .dev.vars)
ADMIN_NOTIFICATION_EMAIL=admin@riotous.store

# Zippyy Logistics & Courier Aggregator API
ZIPPYY_BASE_URL=https://api.zippyy.in
ZIPPYY_EMAIL=
ZIPPYY_PASSWORD=
ZIPPYY_DEFAULT_WAREHOUSE_ID=wh_default_01
ZIPPYY_PICKUP_PINCODE=395006
ZIPPYY_WEBHOOK_URL=
ZIPPYY_WEBHOOK_SECRET=
ZIPPYY_SANDBOX_MODE=true

# Admin Password Reset (Optional)
ADMIN_RESET_PASSWORD=